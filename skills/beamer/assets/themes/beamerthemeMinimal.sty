% beamerthemeHCW.sty — HCW (FH Campus Wien) starter theme for Beamer.
%
% Token-driven extension of Madrid: brand-specific values live in macros at
% the top of the file so the visual identity can be confirmed once and
% propagate to every deck that uses \usetheme{HCW}.
%
% To activate this theme:
%   1. Place this file next to your main .tex, or on TEXINPUTS.
%   2. In the preamble:   \usetheme{HCW}
%
% Once the supervisor confirms the official HCW visual identity, fill in
% the TODO values below. No selectors should need to change.
%
% The colour tokens mirror the marp `hcw-starter.css` companion theme so
% Markdown and Beamer decks can share one source of brand truth.

\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{beamerthemeHCW}[2026/05/13 v0.1 HCW starter theme for Beamer]

\RequirePackage{xcolor}
\RequirePackage{etoolbox}

% ─── Brand colour tokens (TODO: confirm with supervisor / brand guide) ───────
\definecolor{HCWprimary}{HTML}{1F3A8A}      % TODO: HCW primary (navy placeholder)
\definecolor{HCWsecondary}{HTML}{6B7280}    % TODO: HCW secondary (slate placeholder)
\definecolor{HCWaccent}{HTML}{B21F1F}       % TODO: HCW accent (used sparingly)
\definecolor{HCWmuted}{HTML}{6B7280}
\definecolor{HCWrule}{HTML}{E5E7EB}
\definecolor{HCWcodebg}{HTML}{F5F5F5}

% ─── Footer text (TODO: confirm with supervisor) ─────────────────────────────
\providecommand{\HCWfootertext}{BA2 \textperiodcentered\ FH Campus Wien}

% ─── Inherit Madrid's outer layout, then override the colour palette ─────────
\useoutertheme{miniframes}
\useinnertheme{rounded}

\setbeamercolor{palette primary}{fg=white,bg=HCWprimary}
\setbeamercolor{palette secondary}{fg=white,bg=HCWprimary!85}
\setbeamercolor{palette tertiary}{fg=white,bg=HCWprimary!70}
\setbeamercolor{palette quaternary}{fg=white,bg=HCWprimary}

\setbeamercolor{structure}{fg=HCWprimary}
\setbeamercolor{title}{fg=HCWprimary}
\setbeamercolor{subtitle}{fg=HCWsecondary}
\setbeamercolor{author}{fg=black}
\setbeamercolor{institute}{fg=HCWsecondary}
\setbeamercolor{date}{fg=HCWsecondary}

\setbeamercolor{frametitle}{fg=white,bg=HCWprimary}
\setbeamercolor{section in head/foot}{fg=white,bg=HCWprimary}
\setbeamercolor{subsection in head/foot}{fg=white,bg=HCWprimary!85}
\setbeamercolor{author in head/foot}{fg=white,bg=HCWprimary}
\setbeamercolor{title in head/foot}{fg=white,bg=HCWprimary}
\setbeamercolor{date in head/foot}{fg=white,bg=HCWprimary}

\setbeamercolor{block title}{fg=white,bg=HCWprimary}
\setbeamercolor{block body}{fg=black,bg=HCWprimary!5}
\setbeamercolor{block title alerted}{fg=white,bg=HCWaccent}
\setbeamercolor{block body alerted}{fg=black,bg=HCWaccent!8}
\setbeamercolor{block title example}{fg=white,bg=HCWsecondary}
\setbeamercolor{block body example}{fg=black,bg=HCWsecondary!8}

\setbeamercolor{itemize item}{fg=HCWprimary}
\setbeamercolor{itemize subitem}{fg=HCWsecondary}
\setbeamercolor{enumerate item}{fg=HCWprimary}
\setbeamercolor{alerted text}{fg=HCWaccent}

% ─── Typography (TODO: switch to brand font if different) ────────────────────
\setbeamerfont{title}{series=\bfseries,size=\LARGE}
\setbeamerfont{subtitle}{series=\mdseries,size=\large}
\setbeamerfont{frametitle}{series=\bfseries,size=\large}
\setbeamerfont{block title}{series=\bfseries}
\setbeamerfont{footline}{size=\tiny}

% ─── Frame title bar (a touch more padding than Madrid default) ──────────────
\setbeamertemplate{frametitle}{%
  \nointerlineskip%
  \begin{beamercolorbox}[wd=\paperwidth,ht=2.6ex,dp=1.0ex,leftskip=0.6cm,rightskip=0.6cm]{frametitle}%
    \usebeamerfont{frametitle}\insertframetitle%
  \end{beamercolorbox}%
}

% ─── Custom footline: author · footer text · page n/N ────────────────────────
\setbeamertemplate{footline}{%
  \leavevmode%
  \hbox{%
    \begin{beamercolorbox}[wd=.34\paperwidth,ht=2.25ex,dp=1ex,center]{author in head/foot}%
      \usebeamerfont{footline}\insertshortauthor%
    \end{beamercolorbox}%
    \begin{beamercolorbox}[wd=.34\paperwidth,ht=2.25ex,dp=1ex,center]{title in head/foot}%
      \usebeamerfont{footline}\HCWfootertext%
    \end{beamercolorbox}%
    \begin{beamercolorbox}[wd=.32\paperwidth,ht=2.25ex,dp=1ex,center]{date in head/foot}%
      \usebeamerfont{footline}\insertframenumber\,/\,\inserttotalframenumber%
    \end{beamercolorbox}%
  }%
  \vskip0pt%
}

% Hide navigation symbols by default — the dots and arrows nobody uses.
\setbeamertemplate{navigation symbols}{}

% Itemize markers: triangles in HCW primary
\setbeamertemplate{itemize item}{\color{HCWprimary}$\blacktriangleright$}
\setbeamertemplate{itemize subitem}{\color{HCWsecondary}$\blacktriangleright$}

\endinput
