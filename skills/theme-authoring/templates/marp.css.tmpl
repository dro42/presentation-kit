/* @theme ${short} */
/*
 * ${name} — Marp theme generated by theme-authoring.
${generated_by}
 *
 * To activate this theme:
 *   marp deck.md --theme-set ./${short}.css --pdf
 * In deck frontmatter:
 *   theme: ${short}
 *
 * The brand spec is the source of truth — re-run /new-theme to regenerate.
 */

@import 'gaia';

:root {
  /* ─── Brand color tokens ─────────────────────────────────────────────── */
  --primary-color:    ${primary};
  --secondary-color:  ${secondary};
  --primary-soft:     ${primary_soft};${block_accent_var}

  /* ─── Surface tokens ────────────────────────────────────────────────── */
  --bg-color:         ${bg};
  --bg-alt:           ${bg_alt};
  --text-color:       ${text};
  --rule-color:       ${rule};
  --rule-soft:        ${rule_soft};

  /* ─── Typography tokens ─────────────────────────────────────────────── */
  --font-family-body:     ${font_body};
  --font-family-headings: ${font_headings};
  --font-family-mono:     ${font_mono};

  --font-size-base:   ${base_size}px;
  --font-size-h1:     2.4em;
  --font-size-h2:     1.55em;
  --font-size-h3:     1.2em;
}

/* ─── Slide canvas ──────────────────────────────────────────────────────${block_logo_comment} */
section {
  background: var(--bg-color);${block_logo_bg}
  color: var(--text-color);
  font-family: var(--font-family-body);
  font-size: var(--font-size-base);
  padding: ${pad_top}px ${pad_right}px ${pad_bottom}px ${pad_left}px;
}

h1, h2, h3 {
  font-family: var(--font-family-headings);
  font-weight: 600;
}

h1 {
  color: var(--primary-color);
  font-size: var(--font-size-h1);
  margin-bottom: 0.5em;
  border-bottom: 2px solid var(--rule-color);
  padding-bottom: 0.18em;
  display: inline-block;
}
h2 { color: var(--secondary-color); font-size: var(--font-size-h2); }
h3 { color: var(--primary-soft); font-size: var(--font-size-h3); }

a       { color: var(--primary-color); text-decoration: underline; text-underline-offset: 3px; }
strong  { color: var(--primary-color); }

code {
  background: ${code_bg};
  color: var(--primary-color);
  padding: 0.1em 0.35em;
  border-radius: 3px;
  font-family: var(--font-family-mono);
  font-size: 0.9em;
}

pre {
  background: ${code_bg};
  border-left: ${code_border_width}px solid ${code_border};
  padding: 0.7em 1em;
  border-radius: 4px;
  font-size: ${code_font_size}em;
  line-height: 1.4;
}
pre code { background: transparent; color: var(--text-color); padding: 0; }

hr {
  border: none;
  border-top: 1px solid var(--rule-soft);
  margin: 0.8em 0;
}

blockquote {
  border-left: 3px solid var(--primary-color);
  background: var(--bg-alt);
  color: var(--secondary-color);
  padding: 0.6em 1em;
  margin-left: 0;
  font-style: italic;
}

table { border-collapse: collapse; width: 100%; }
th, td {
  border-bottom: 1px solid ${table_cell_border};
  padding: 0.4em 0.8em;
  text-align: left;
}
th {
  color: ${table_header};
  border-bottom: ${table_header_border}px solid ${table_header};
}

ul li::marker { color: var(--primary-color); }
ol li::marker { color: var(--primary-color); font-weight: 600; }

/* ─── Header / footer / pagination ────────────────────────────────────── */
header {
  color: var(--secondary-color);
  font-size: 0.55em;
  font-weight: 600;
  letter-spacing: 0.04em;
  text-transform: uppercase;
}
footer {
  color: var(--secondary-color);
  font-size: 0.55em;
  border-top: 1px solid var(--rule-soft);
  padding-top: 0.4em;
}
section::after {
  color: var(--primary-color);
  font-weight: 600;
  font-size: 0.65em;
}
${block_lead}${block_invert}${block_two_column}
/* ─── End of generated theme ──────────────────────────────────────────── */
