{
  "name": "slidev-theme-${short}",
  "version": "0.1.0",
  "description": "${name} Slidev theme — generated by theme-authoring.",
  "keywords": ["slidev-theme", "presentation", "slidev"],
  "license": "MIT",
  "slidev": {
    "defaults": {
      "aspectRatio": "16/9",
      "canvasWidth": 980,
      "colorSchema": "auto",
      "fonts": {
        "sans": ${slidev_font_sans},
        "serif": "Iowan Old Style, Georgia, serif",
        "mono": ${slidev_font_mono}
      },
      "highlighter": "shiki",
      "transition": "slide-left"
    }
  }
}
