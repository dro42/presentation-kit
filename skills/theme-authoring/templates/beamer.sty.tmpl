% beamertheme${short_pascal}.sty — ${name} Beamer theme generated by theme-authoring.
${generated_by}
%
% To activate this theme:
%   1. Place this file next to your main .tex, or on TEXINPUTS.
%   2. In the preamble:   \usetheme{${short_pascal}}
%
% The brand spec is the source of truth — re-run /new-theme to regenerate.

\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{beamertheme${short_pascal}}[${date_today} v0.1 ${name} theme]

\RequirePackage{xcolor}
\RequirePackage{etoolbox}${block_logo_packages}

% --- Brand color tokens ----------------------------------------------------
\definecolor{BrandPrimary}{HTML}{${primary_hex}}
\definecolor{BrandSecondary}{HTML}{${secondary_hex}}
\definecolor{BrandPrimarySoft}{HTML}{${primary_soft_hex}}${block_accent_color}
\definecolor{BrandText}{HTML}{${text_hex}}
\definecolor{BrandBg}{HTML}{${bg_hex}}
\definecolor{BrandBgAlt}{HTML}{${bg_alt_hex}}
\definecolor{BrandRule}{HTML}{${rule_hex}}
\definecolor{BrandRuleSoft}{HTML}{${rule_soft_hex}}
\definecolor{BrandInverseText}{HTML}{${inverse_text_hex}}
\definecolor{BrandInverseBg}{HTML}{${inverse_bg_hex}}

% --- Footer text -----------------------------------------------------------
\providecommand{\${short_pascal}FooterText}{${footer_text_tex}}

% --- Outer / inner theme inheritance --------------------------------------
\useoutertheme{infolines}
\useinnertheme{rounded}

% --- Color palette ---------------------------------------------------------
\setbeamercolor{normal text}{fg=BrandText,bg=BrandBg}
\setbeamercolor{structure}{fg=BrandPrimary}
\setbeamercolor{title}{fg=BrandPrimary}
\setbeamercolor{subtitle}{fg=BrandSecondary}
\setbeamercolor{author}{fg=BrandText}
\setbeamercolor{institute}{fg=BrandSecondary}
\setbeamercolor{date}{fg=BrandSecondary}

\setbeamercolor{frametitle}{fg=BrandInverseText,bg=BrandPrimary}
\setbeamercolor{framesubtitle}{fg=BrandPrimarySoft}

\setbeamercolor{palette primary}{fg=BrandInverseText,bg=BrandPrimary}
\setbeamercolor{palette secondary}{fg=BrandInverseText,bg=BrandPrimary!85}
\setbeamercolor{palette tertiary}{fg=BrandInverseText,bg=BrandPrimary!70}
\setbeamercolor{palette quaternary}{fg=BrandInverseText,bg=BrandPrimary}

\setbeamercolor{section in head/foot}{fg=BrandInverseText,bg=BrandPrimary}
\setbeamercolor{subsection in head/foot}{fg=BrandInverseText,bg=BrandPrimary!85}
\setbeamercolor{author in head/foot}{fg=BrandInverseText,bg=BrandPrimary}
\setbeamercolor{title in head/foot}{fg=BrandInverseText,bg=BrandPrimary}
\setbeamercolor{date in head/foot}{fg=BrandInverseText,bg=BrandPrimary}

\setbeamercolor{block title}{fg=BrandInverseText,bg=BrandPrimary}
\setbeamercolor{block body}{fg=BrandText,bg=BrandBgAlt}
\setbeamercolor{block title example}{fg=BrandInverseText,bg=BrandSecondary}
\setbeamercolor{block body example}{fg=BrandText,bg=BrandBgAlt}${block_alerted_color}

\setbeamercolor{itemize item}{fg=BrandPrimary}
\setbeamercolor{itemize subitem}{fg=BrandSecondary}
\setbeamercolor{itemize subsubitem}{fg=BrandPrimarySoft}
\setbeamercolor{enumerate item}{fg=BrandPrimary}

% --- Typography ------------------------------------------------------------
\setbeamerfont{title}{series=\bfseries,size=\LARGE}
\setbeamerfont{subtitle}{series=\mdseries,size=\large}
\setbeamerfont{frametitle}{series=\bfseries,size=\large}
\setbeamerfont{block title}{series=\bfseries}
\setbeamerfont{footline}{size=\tiny}
\setbeamerfont{caption}{size=\footnotesize}

% --- Frame title bar -------------------------------------------------------
\setbeamertemplate{frametitle}{%
  \nointerlineskip%
  \begin{beamercolorbox}[wd=\paperwidth,ht=2.6ex,dp=1.0ex,leftskip=0.6cm,rightskip=0.6cm]{frametitle}%
    \usebeamerfont{frametitle}\insertframetitle%
  \end{beamercolorbox}%
}

% --- Footline: author / footer text / page n/N -----------------------------
\setbeamertemplate{footline}{%
  \leavevmode%
  \hbox{%
    \begin{beamercolorbox}[wd=.34\paperwidth,ht=2.25ex,dp=1ex,center]{author in head/foot}%
      \usebeamerfont{footline}\insertshortauthor%
    \end{beamercolorbox}%
    \begin{beamercolorbox}[wd=.34\paperwidth,ht=2.25ex,dp=1ex,center]{title in head/foot}%
      \usebeamerfont{footline}\${short_pascal}FooterText%
    \end{beamercolorbox}%
    \begin{beamercolorbox}[wd=.32\paperwidth,ht=2.25ex,dp=1ex,center]{date in head/foot}%
      \usebeamerfont{footline}\insertframenumber\,/\,\inserttotalframenumber%
    \end{beamercolorbox}%
  }%
  \vskip0pt%
}

\setbeamertemplate{navigation symbols}{}

\setbeamertemplate{itemize item}{\color{BrandPrimary}$\blacktriangleright$}
\setbeamertemplate{itemize subitem}{\color{BrandSecondary}$\blacktriangleright$}
\setbeamertemplate{itemize subsubitem}{\color{BrandPrimarySoft}$\bullet$}${block_logo_overlay}${block_section_page}

\endinput
