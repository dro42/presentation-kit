# macOS
.DS_Store

# Editor
.vscode/
.idea/
*.swp

# Node (for marp-cli local installs if any)
node_modules/
package-lock.json

# LaTeX build artifacts (when testing inside the repo)
*.aux
*.fdb_latexmk
*.fls
*.log
*.nav
*.out
*.snm
*.synctex.gz
*.toc
*.vrb
*.bbl
*.blg

# Build output dirs used by smoke tests
build/
/tmp-out/

# Marp local cache
.marprc

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
*.egg
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Python virtual environments (e.g. for python-pptx in theme-authoring)
.venv/
venv/
env/
.python-version

# Skill bundle output (rebuilt on demand via scripts/build-skill-bundles.sh)
dist/

# Generated themes (created by skills/theme-authoring/scripts/new_theme.py)
# The /examples/ baseline specs are committed; runtime outputs are not.
/themes/
skills/*/themes-out/

# Secrets / credentials — never commit these
.env
.env.*
*.pem
*.key
*.p12
secrets/
credentials/

# Direnv
.envrc
.direnv/

# OS noise
Thumbs.db
ehthumbs.db
Desktop.ini

# Editor extras
*.swo
*~
.vscode/*.local.*

